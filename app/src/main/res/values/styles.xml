<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HMS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:colorPrimary">@color/charcoal</item>
        <item name="android:colorAccent">@color/bronze</item>
        <item name="android:colorControlActivated">@color/bronze</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/secondary</item>
        <item name="android:textColorHint">@color/secondary</item>
    </style>
    <!-- light dialogs that match the home look -->
    <style name="HmsDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_l</item>
        <item name="android:colorAccent">@color/h_accent</item>
        <item name="android:colorControlActivated">@color/h_accent</item>
        <item name="android:textColorPrimary">@color/h_ink</item>
        <item name="android:textColorSecondary">@color/h_ink2</item>
        <item name="android:textColorHint">@color/h_ink2</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
