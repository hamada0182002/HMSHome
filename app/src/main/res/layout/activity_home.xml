<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:clipChildren="false">

    <!-- top bar: clock + Wi-Fi + device settings + HMS settings (right side, like the design) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical|end"
        android:paddingLeft="48dp" android:paddingRight="40dp" android:paddingTop="14dp" android:paddingBottom="2dp">
        <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="HH:mm"
            android:textColor="@color/h_ink2" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginRight="10dp"/>
        <ImageView android:id="@+id/btnWifi" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="11dp" android:src="@drawable/ic_wifi" android:focusable="true" android:clickable="true"
            android:background="@drawable/bg_status_btn" android:contentDescription="Wi-Fi"/>
        <ImageView android:id="@+id/btnDevice" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="11dp" android:src="@drawable/ic_settings" android:focusable="true" android:clickable="true"
            android:background="@drawable/bg_status_btn" android:contentDescription="Device settings"/>
        <ImageView android:id="@+id/btnApp" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="11dp" android:src="@drawable/ic_tune" android:focusable="true" android:clickable="true"
            android:background="@drawable/bg_status_btn" android:contentDescription="HMS HOME settings"/>
    </LinearLayout>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none" android:clipChildren="false">
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:clipChildren="false" android:paddingBottom="40dp"/>
    </ScrollView>
</LinearLayout>
